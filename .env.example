# Hypertext Studio — environment variables
# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
SITE_URL=https://hypertext.studio
PUBLIC_SITE_NAME=Hypertext Studio

# ---------------------------------------------------------------------------
# Build metadata (set automatically by scripts/content-id.sh in CI; the
# values here are fallbacks for local dev so the status panel renders.)
# ---------------------------------------------------------------------------
PUBLIC_BUILD_HASH=dev
PUBLIC_BUILD_TIME=
PUBLIC_DEPLOY_REGION=local
PUBLIC_PAGE_COUNT=0
PUBLIC_WORD_COUNT=0

# ---------------------------------------------------------------------------
# Identity. Leave BLUESKY_HANDLE blank to keep the profile private while
# preserving AT Protocol discovery and syndication infrastructure.
# ---------------------------------------------------------------------------
BLUESKY_HANDLE=
BLUESKY_DID=

# ---------------------------------------------------------------------------
# Cloudflare (deployment + workers). Pull these from the dashboard after
# `wrangler login` runs in bootstrap. Used by GitHub Actions, not local dev.
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=hypertext-studio

# ---------------------------------------------------------------------------
# GitHub repo (used by deployment workflows + scripts/verify-rels.sh)
# ---------------------------------------------------------------------------
GITHUB_REPO=TheHypertextStudio/website

# ---------------------------------------------------------------------------
# Worker secrets (per-worker via `wrangler secret put`, NOT in this file).
# Documented here so contributors know what each worker expects:
#   webmention worker:  none (uses D1 binding)
#   micropub worker:    GITHUB_TOKEN (fine-grained token with repository
#                       Contents permission set to Read and write)
#                       INDIEAUTH_ENDPOINT is public config in wrangler.toml
#   poem worker:        none (DoH lookup is unauthenticated)
#   oembed worker:      none
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Webmentions (build-time fetch)
# ---------------------------------------------------------------------------
# Override the URL used by src/lib/webmentions.ts when fetching verified
# mentions for each study/note at build time. Leave unset to hit the
# production worker. CI builds from a fork can set this to an unreachable
# host to force the empty-citation render path. See docs/operations.md
# "Build-time fetch configuration" for the full table.
WEBMENTION_API_URL=

# ---------------------------------------------------------------------------
# Test fixtures
# ---------------------------------------------------------------------------
# When set to '1', merges tests/fixtures/content/* into the public content
# collections so [slug] routes have something to render. Playwright sets
# this automatically; do not set it for production builds. See
# src/content.config.ts.
HYPERTEXT_INCLUDE_FIXTURES=
