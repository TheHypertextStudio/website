# Hypertext Studio — environment variables
# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
SITE_URL=https://hypertext.studio
PUBLIC_SITE_NAME=Hypertext Studio

# Optional manual Cloudflare Web Analytics. Use the existing site token; leave
# blank to load no beacon. Disable provider automatic injection before enabling.
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# ---------------------------------------------------------------------------
# Identity. Leave BLUESKY_HANDLE and BLUESKY_DID blank to publish no Bluesky
# profile or AT Protocol identity. Supplying them enables the corresponding
# public discovery metadata at build time.
# ---------------------------------------------------------------------------
BLUESKY_HANDLE=
BLUESKY_DID=

# ---------------------------------------------------------------------------
# Cloudflare credentials are managed by the approved release workflow and
# are not stored in local .env files. Local Worker development uses Wrangler's
# isolated staging environment and the existing project CLI authentication.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# GitHub repo (used by deployment workflows + scripts/verify-rels.sh)
# ---------------------------------------------------------------------------
GITHUB_REPO=TheHypertextStudio/website

# ---------------------------------------------------------------------------
# Worker secrets stay isolated by service. Micropub's GITHUB_TOKEN belongs
# only to the production Micropub Worker and must never be added here or to a
# site build/preview. INDIEAUTH_ENDPOINT is public config in its Worker config.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Webmentions (build-time fetch)
# ---------------------------------------------------------------------------
# Override the URL used by src/lib/webmentions.ts when fetching verified
# mentions for each study/note at build time. Leave unset to hit the
# production worker. CI builds from a fork can set this to an unreachable
# host to force the empty-citation render path. See docs/operations.md
# "Build-time fetch configuration" for the full table.
WEBMENTION_API_URL=

# ---------------------------------------------------------------------------
# Test fixtures
# ---------------------------------------------------------------------------
# When set to '1', merges tests/fixtures/content/* into the public content
# collections so [slug] routes have something to render. Playwright sets
# this automatically; do not set it for production builds. See
# src/content.config.ts.
HYPERTEXT_INCLUDE_FIXTURES=
