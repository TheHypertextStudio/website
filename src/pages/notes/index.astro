---
/**
 * Notes index — short-form posts. Same skeletal shape as the studies index
 * (lede + ordered list of entries + card-shaped empty state) so the page
 * reads as built, not blank, when no notes have been posted yet.
 *
 * Each note carries its received-citation count in the meta line, fetched
 * at build time from the webmention worker. Counts are silent when zero.
 */
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getWebmentions } from '@/lib/webmentions';
import { isoDate } from '@/i18n/format';
import { SITE_URL } from '@/consts';
import t from '@/i18n';

function snippetOf(body: string | undefined, max = 220): string {
  const collapsed = (body ?? '').replace(/\s+/g, ' ').trim();
  if (collapsed.length <= max) return collapsed;
  const cut = collapsed.slice(0, max);
  const last = cut.lastIndexOf(' ');
  return `${(last > 0 ? cut.slice(0, last) : cut).trimEnd()}…`;
}

const allNotes = await getCollection('notes');
const notes = allNotes.sort(
  (a: CollectionEntry<'notes'>, b: CollectionEntry<'notes'>) =>
    b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

// Fetch citation counts in parallel at build. Failures are silent (lib
// returns empty groups). A local build without network access still works.
const citationCounts = await Promise.all(
  notes.map((n: CollectionEntry<'notes'>) =>
    getWebmentions(`${SITE_URL}/notes/${n.id}`).then((g) => g.citations.length),
  ),
);

// Pre-bake the per-row data so the JSX template stays declarative — Astro's
// expression syntax doesn't allow `const` inside arrow-function bodies in
// JSX children.
const rows = notes.map((n: CollectionEntry<'notes'>, i: number) => ({
  note: n,
  cited: citationCounts[i] ?? 0,
  replyHost: n.data.inReplyTo ? new URL(n.data.inReplyTo).host : null,
  snippet: snippetOf(n.body),
}));
---

<Base
  title={t.notes.indexHeading}
  description="Short writings from Hypertext Studio."
  sourcePath="src/pages/notes/index.astro"
>
  <article class="notes-layout">
    <header class="notes-header">
      <h1>{t.notes.indexHeading}</h1>
      <p class="lede">{t.notes.lede}</p>
    </header>

    {
      rows.length === 0 ? (
        <section class="notes-empty">
          <article class="note-card note-card--empty" aria-labelledby="empty-heading">
            <h2 id="empty-heading">{t.notes.empty.heading}</h2>
            <p>{t.notes.empty.body}</p>
          </article>
        </section>
      ) : (
        <section class="notes-list">
          <ol role="list">
            {rows.map(({ note, cited, replyHost, snippet }) => (
              <li>
                <article class="note-card">
                  <p class="meta">
                    <time datetime={note.data.publishedAt.toISOString()}>
                      {isoDate(note.data.publishedAt)}
                    </time>
                    {replyHost && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span>
                          {t.notes.inReplyToLabel}{' '}
                          <a href={note.data.inReplyTo} rel="external">
                            {replyHost}
                          </a>
                        </span>
                      </>
                    )}
                    {cited > 0 && (
                      <>
                        <span aria-hidden="true">·</span>
                        <span>
                          {cited} {t.notes.citedSuffix}
                        </span>
                      </>
                    )}
                  </p>
                  <p class="snippet">
                    <a href={`/notes/${note.id}`}>{snippet}</a>
                  </p>
                </article>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </article>
</Base>

<style>
  .notes-layout {
    max-inline-size: 60rem;
    margin-inline: auto;
    padding-inline: var(--layout-margin);
    padding-block: var(--space-xxl) var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .notes-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-inline-size: var(--measure);
  }

  .notes-header h1 {
    font-family: var(--font-sans);
    font-size: var(--font-size-headline);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0;
  }

  .notes-header .lede {
    font-family: var(--font-serif);
    font-size: var(--font-size-body-lg);
    line-height: var(--leading-body);
    color: var(--color-secondary);
    text-wrap: pretty;
    margin: 0;
  }

  .notes-list ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .notes-list li {
    border-block-start: var(--rule-thin);
  }
  .notes-list li:last-child {
    border-block-end: var(--rule-thin);
  }

  .note-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-block: var(--space-lg);
    max-inline-size: var(--measure);
  }

  .note-card .meta {
    font-family: var(--font-mono);
    font-size: var(--font-size-label-sm);
    color: var(--color-secondary);
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5ch;
    margin: 0;
    align-items: baseline;
  }

  .note-card .meta a {
    color: var(--color-secondary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .note-card .meta a:hover {
    color: var(--color-link);
  }

  .note-card .snippet {
    font-family: var(--font-serif);
    font-size: var(--font-size-body);
    line-height: var(--leading-body);
    color: var(--color-text);
    margin: 0;
    text-wrap: pretty;
  }

  .note-card .snippet a {
    color: inherit;
    text-decoration: none;
  }

  .note-card .snippet a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .notes-empty {
    border-block: var(--rule-thin);
  }

  .note-card--empty {
    padding-block: var(--space-xl);
    color: var(--color-secondary);
  }

  .note-card--empty h2 {
    font-family: var(--font-sans);
    font-size: var(--font-size-title-lg);
    color: var(--color-text);
    margin: 0;
  }

  .note-card--empty p {
    font-family: var(--font-serif);
    font-size: var(--font-size-body);
    line-height: var(--leading-body);
    margin: 0;
  }
</style>
