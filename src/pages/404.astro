---
import Base from '@/layouts/Base.astro';
import t from '@/i18n';
---

<Base title={t.page404.title} description={t.page404.body} noIndex>
  <article class="prose-layout">
    <header>
      <h1>{t.page404.title}</h1>
      <p>{t.page404.body}</p>
    </header>
    <p>
      <a href="/" rel="home">{t.page404.homeLinkLabel}</a>
    </p>
  </article>
</Base>
