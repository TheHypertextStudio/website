---
import Base from '@/layouts/Base.astro';
import { serviceChoices } from '@/data/services';
import '@/styles/services.css';
import '@/styles/work-together.css';
---

<Base
  title="Work together"
  description="Find a starting point for a product decision, software redesign, AI idea, or custom website, app, or platform."
>
  <div class="hx-shell hx-work" id="work-together">
    <p class="hx-breadcrumb"><a href="/">studio</a> / work together</p>
    <p class="hx-progress" id="progress" aria-live="polite" hidden>Step 1 of 3</p>
    <h1 id="work-title" tabindex="-1">What do you need help with?</h1>
    <noscript
      ><p>
        Email me about your project, a decision you’re working through, or a product you need.
        Nonprofits and community projects can ask about reduced rates.
      </p><a href="mailto:hello@hypertext.studio">Email Willie</a></noscript
    >
    <div id="chooser" hidden>
      <section class="hx-step" data-step="1" aria-labelledby="work-title">
        <fieldset>
          <legend class="sr-only">Choose the situation closest to yours</legend>
          {
            serviceChoices.map(({ value, label }) => (
              <label class="hx-radio">
                <input type="radio" name="need" value={value} />
                {label}
              </label>
            ))
          }
        </fieldset>
        <div class="hx-step-actions">
          <a class="hx-link" href="/">Back to studio</a><button
            class="hx-link"
            id="first-next"
            type="button"
            disabled>Continue <span aria-hidden="true">→</span></button
          >
        </div>
      </section>
      <section class="hx-step" data-step="2" aria-labelledby="work-title" hidden>
        <p class="hx-step-copy">A sentence or two is enough. You can also leave this blank.</p>
        <div class="hx-field">
          <label class="hx-label" for="context">Your situation <span>(optional)</span></label
          ><textarea id="context" maxlength="8000"></textarea>
        </div>
        <label class="hx-nonprofit"
          ><input id="nonprofit" type="checkbox" />This is for a nonprofit, community project, or
          social cause.</label
        >
        <p class="hx-nonprofit-note" id="nonprofit-note" hidden>
          Tell me who the work helps. We can discuss reduced rates.
        </p>
        <div class="hx-step-actions">
          <button class="hx-link" type="button" data-back>Back</button><button
            class="hx-link"
            id="second-next"
            type="button">See a starting point <span aria-hidden="true">→</span></button
          >
        </div>
      </section>
      <section class="hx-step" data-step="3" aria-labelledby="work-title" hidden>
        <div class="hx-result" id="result">
          <p class="hx-result-description" id="result-description"></p><ul id="result-items"></ul>
          <p id="reduced" class="hx-reduced" hidden>
            We can discuss reduced rates for your nonprofit, community project, or social cause.
          </p>
          <button class="hx-link hx-prepare" id="prepare" type="button"
            >Prepare an enquiry <span aria-hidden="true">→</span></button
          >
          <p class="hx-result-note" id="result-note">
            You can review and edit the message before sending it.
          </p>
        </div>
        <div class="hx-brief" id="brief" hidden>
          <label class="hx-label" for="brief-text">Your enquiry</label><textarea id="brief-text"
          ></textarea>
          <div class="hx-brief-actions">
            <a class="hx-link" id="email-enquiry" href="mailto:hello@hypertext.studio"
              >Email enquiry <span aria-hidden="true">↗</span></a
            ><button class="hx-link" id="copy" type="button">Copy enquiry</button>
          </div>
          <p class="hx-result-note">This opens your email app. You choose when to send it.</p><p
            id="copy-status"
            class="hx-result-note"
            role="status"
          >
          </p>
        </div>
        <div class="hx-step-actions">
          <button class="hx-link" type="button" data-back>Back</button>
        </div>
      </section>
    </div>
  </div>
</Base>
<script>
  import '@/scripts/work-together';
</script>
