---
import Base from '@/layouts/Base.astro';
import t from '@/i18n';
---

<Base
  title="Privacy"
  description="How Hypertext Studio handles website visits, enquiries, email, and webmentions."
>
  <article class="prose-layout">
    <header>
      <h1>{t.privacy.title}</h1>
      <p class="lede">{t.privacy.intro}</p>
      <div class="policy-metadata">
        <p>
          Published and effective <time datetime={t.privacy.effective}>October 14, 2026</time>.
        </p>
        <nav aria-label="Policy navigation">
          <a href="/terms">Website terms</a> · <a href="/legal/history">Policy history</a>
        </nav>
      </div>
    </header>
    {t.privacy.sections.map((s) => (
      <section class="flow">
        <h2 id={s.id}>
          <a class="anchor" href={`#${s.id}`} aria-label={`Permalink to ${s.heading}`}>
            #
          </a>
          {s.heading}
        </h2>
        {s.body.split('\n\n').map((p) => (
          <p set:html={p.replace(/`([^`]+)`/g, '<code>$1</code>')} />
        ))}
      </section>
    ))}
  </article>
</Base>

<style>
  .policy-metadata {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    color: var(--color-secondary);
  }
  .policy-metadata p {
    margin: 0;
  }
</style>
