---
import Base from '@/layouts/Base.astro';
import t from '@/i18n';
---

<Base
  title="Privacy"
  description="What we collect (almost nothing) and why."
  sourcePath="src/pages/privacy.astro"
>
  <article class="prose-layout">
    <header>
      <h1>{t.privacy.title}</h1>
      <p class="lede">{t.privacy.intro}</p>
    </header>
    {
      t.privacy.sections.map((s) => (
        <section>
          <h2 id={s.id}>
            <a class="anchor" href={`#${s.id}`} aria-label={`Permalink to ${s.heading}`}>
              #
            </a>
            {s.heading}
          </h2>
          {s.body.split('\n\n').map((p) => (
            <p set:html={p.replace(/`([^`]+)`/g, '<code>$1</code>')} />
          ))}
        </section>
      ))
    }
  </article>
</Base>
