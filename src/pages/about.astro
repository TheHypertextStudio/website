---
import Base from '@/layouts/Base.astro';
---

<Base title="About" description="About Hypertext Studio and its founder, Willie Chalmers III.">
  <article class="prose-layout">
    <h1>About</h1>
    <div class="about-copy">
      <p>
        <a href="https://williecubed.me" rel="me external noopener">Willie Chalmers III</a>{' '}
        started Hypertext Studio as a home for his apps that didn’t really fit anywhere else.
      </p>
      <p>
        In his free time, he advocates for world-class public transportation in Las Vegas through
        his nonprofit, <a href="https://lasvegasfortransit.org" rel="external noopener"
          >Las Vegans for Better Transit</a
        >.
      </p>
    </div>
  </article>
</Base>

<style>
  .about-copy {
    display: grid;
    gap: 1.25rem;
    font-size: clamp(1.25rem, 2.3vw, 1.75rem);
    line-height: 1.45;
    letter-spacing: -0.025em;
  }
</style>
