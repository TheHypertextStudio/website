---
const path = Astro.url.pathname.replace(/\/$/, '');
---

<header class="site-header">
  <a
    class="site-wordmark interaction-target"
    href="/"
    title="Hypertext Studio — home"
    rel="home"
    translate="no"
  >
    <span class="interaction-label" aria-hidden="true">&lt;hypertext-studio&gt;</span>
    <span class="sr-only">Hypertext Studio home</span>
  </a>
  <nav aria-label="Primary">
    <a
      class="interaction-target"
      href="/services/"
      aria-current={path === '/services' ? 'page' : undefined}
      ><span class="interaction-label">Services</span></a
    >
    <a class="interaction-target" href="/#products"
      ><span class="interaction-label">Products</span></a
    >
    <a
      class="interaction-target"
      href="/about"
      aria-current={path === '/about' ? 'page' : undefined}
      ><span class="interaction-label">About</span></a
    >
  </nav>
  <a
    class="site-enquiry"
    href="/work-together/"
    aria-current={path === '/work-together' ? 'page' : undefined}
    >Let’s talk <span aria-hidden="true">→</span></a
  >
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    /* Above page content, below the skip link (999) and the studies sticky
     * headings (2), which scroll underneath the bar. */
    z-index: 10;
    inline-size: 100%;
    max-inline-size: var(--layout-max);
    min-inline-size: 0;
    margin-inline: auto;
    padding: 0.625rem var(--layout-margin);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.5rem, 3vw, 2.75rem);
  }

  /* The scrolled panel, painted as a pseudo-element behind the bar's own
   * content so the blur never filters the text sitting on top of it. Its
   * resting state is "on": engines without scroll-driven animations, and
   * readers who ask for reduced motion, get a legible bar rather than
   * transparent text over scrolling content. The animation below only takes
   * it away at the very top of the page, where nothing is underneath. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header::before {
      background: var(--color-bg);
    }
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .site-header::before {
        animation: header-panel-in linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 var(--header-block-size);
      }
    }
  }

  @keyframes header-panel-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  .site-wordmark {
    /* Published as a variable so the home page's scroll handoff can land the
     * mark on the same size the bar rests at, at every breakpoint. */
    --wordmark-rest-size: 0.9375rem;
    font-family: var(--font-mono);
    font-size: var(--wordmark-rest-size);
    letter-spacing: -0.03em;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-wordmark:focus-visible {
    color: var(--color-text);
    -webkit-text-fill-color: var(--color-text);
  }

  .site-wordmark .interaction-label {
    text-decoration: none;
  }

  nav {
    /* Holds the nav against the inline end even when the wordmark leaves the
     * flex row during the home page's scroll handoff. */
    margin-inline-start: auto;
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
    font-size: 0.9375rem;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--color-secondary);
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    color: var(--color-text);
  }

  nav a:hover {
    text-decoration: none;
  }

  nav a:focus-visible {
    color: var(--color-text);
    -webkit-text-fill-color: var(--color-text);
    text-decoration: none;
  }

  nav .interaction-label {
    text-decoration-line: none;
    text-underline-offset: 0.25em;
  }

  nav a[aria-current='page'] .interaction-label,
  nav a:hover .interaction-label {
    text-decoration-line: underline;
  }

  .site-enquiry {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-block-size: 2.75rem;
    padding: 0.5rem 0.875rem;
    color: var(--color-text);
    background: var(--color-footer-bg);
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-enquiry:visited {
    color: var(--color-text);
  }

  .site-enquiry:hover {
    background: var(--interaction-hover-bg);
    text-decoration: none;
  }

  .site-enquiry:focus-visible {
    color: var(--interaction-focus-ink);
    background: var(--interaction-focus-bg);
  }

  @media (max-width: 44rem) {
    .site-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 0.75rem;
      row-gap: 0;
    }

    .site-wordmark {
      --wordmark-rest-size: clamp(0.75rem, 3.333vw, 0.8125rem);
      display: inline-flex;
      align-items: center;
      min-block-size: 2.75rem;
      font-size: var(--wordmark-rest-size);
    }

    nav {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-inline-start: 0;
      inline-size: 100%;
      justify-content: start;
      min-inline-size: 0;
      flex-direction: row;
      align-items: center;
      gap: 1.75rem;
      font-size: 0.8125rem;
    }

    .site-enquiry {
      grid-column: 2;
      grid-row: 1;
      gap: 0.5rem;
      padding-inline: 0.625rem;
      font-size: 0.8125rem;
    }
  }

  @media (forced-colors: active) {
    .site-header::before {
      animation: none;
      opacity: 1;
      background: Canvas;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      border-block-end: 1px solid CanvasText;
    }
  }
</style>
