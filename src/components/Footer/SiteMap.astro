---
import t from '@/i18n';
---

<section class="footer-section" aria-labelledby="footer-sitemap-heading">
  <h2 id="footer-sitemap-heading" class="footer-section__heading">{t.footer.siteMap.heading}</h2>
  <ul class="footer-section__list">
    {
      t.footer.siteMap.items.map((item) => (
        <li>
          <a href={item.href} title={item.label}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* Reset the global `section { gap: var(--space-lg) }` rule from
   * src/styles/layout.css — without this, the heading sits 2rem above the
   * list, breaking rhythm with Studio/Colophon (which use the same 0.5rem
   * gap pattern). */
  .footer-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: 0;
  }

  .footer-section__heading {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 400;
    margin: 0;
  }

  .footer-section__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    font-family: var(--font-sans);
    font-size: var(--font-size-small);
    padding: 0;
    margin: 0;
  }
</style>
