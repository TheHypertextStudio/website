---
import t from '@/i18n';

const buildHash = import.meta.env.PUBLIC_BUILD_HASH || 'dev';
const buildTime = import.meta.env.PUBLIC_BUILD_TIME || new Date().toISOString();
const region = import.meta.env.PUBLIC_DEPLOY_REGION || 'local';
const labels = t.footer.statusPanel;
---

<section class="status-panel" aria-label="Studio status">
  <dl>
    <dt>{labels.studioTime}</dt>
    <dd data-status="time">--:-- PT</dd>
    <dt>{labels.location}</dt>
    <dd>Las Vegas, NV</dd>
    <dt>{labels.edge}</dt>
    <dd data-status="edge">Cloudflare {region.toUpperCase()}</dd>
    <dt>{labels.render}</dt>
    <dd data-status="render">— ms</dd>
    <dt>{labels.build}</dt>
    <dd>#{buildHash}</dd>
    <dt>{labels.deployed}</dt>
    <dd>
      <time datetime={buildTime}>{buildTime.slice(0, 16).replace('T', ' ')}Z</time>
    </dd>
  </dl>
</section>

<style>
  .status-panel dl {
    grid-template-columns: max-content 1fr;
    column-gap: var(--space-md);
    row-gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    line-height: var(--leading-meta);
  }

  .status-panel dt {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-secondary);
    letter-spacing: 0.05em;
    text-transform: none;
  }

  .status-panel dd {
    color: var(--color-text);
  }
</style>
