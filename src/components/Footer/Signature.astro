---
/**
 * Closing salutation, the way a small-press book ends a chapter — italic
 * "Faithfully," and the studio's name on the line below. Calm, brief,
 * earned by the rest of the footer above it.
 */
import t from '@/i18n';
---

<p class="signature">
  <em>{t.footer.signature.salutation}</em>
  <br />
  {t.footer.signature.name}
</p>

<style>
  .signature {
    margin: 0;
    padding-inline: var(--layout-margin);
    padding-block: var(--space-sm) var(--space-md);
    text-align: center;
    font-family: var(--font-serif);
    font-size: var(--font-size-body-sm);
    line-height: var(--leading-body);
    color: var(--color-secondary);
  }

  .signature em {
    font-style: italic;
  }
</style>
