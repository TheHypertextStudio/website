---
import Wordmark from './Wordmark.astro';
import Studio from './Studio.astro';
import SiteMap from './SiteMap.astro';
import Identity from './Identity.astro';
import StatusPanel from './StatusPanel.astro';
import SmallPrint from './SmallPrint.astro';
import PoemEasterEgg from './PoemEasterEgg.astro';

interface Props {
  sourcePath?: string;
}

const { sourcePath } = Astro.props;
---

<footer class="studio-footer" aria-label="Closing">
  <div class="studio-footer__core">
    <Studio />
    <SiteMap />
    <Identity />
    <StatusPanel />
  </div>
  <div class="studio-footer__anchor">
    <Wordmark />
  </div>
  <SmallPrint sourcePath={sourcePath} />
  <PoemEasterEgg />
</footer>

<style>
  .studio-footer {
    block-size: 100dvh;
    max-block-size: 100dvh;
    display: grid;
    grid-template-rows:
      auto /* operational core */
      minmax(0, 1fr) /* wordmark anchor — fills remaining space */
      auto; /* small print */
    background: var(--color-bg);
    border-block-start: var(--rule-thin);
    overflow: hidden;
  }

  .studio-footer__core {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: var(--space-lg);
    padding-inline: var(--layout-margin);
    padding-block: var(--space-xl) var(--space-lg);
    align-content: start;
    min-block-size: 0;
    overflow: hidden;
    border-block-end: var(--rule-thin);
  }

  .studio-footer__anchor {
    /* Grid (not flex) so the wordmark child stretches to the row's full
     * inline-size — required because the wordmark establishes a container
     * query, which implies `contain: inline-size` and would otherwise
     * collapse a content-sized flex child to its padding. */
    display: grid;
    align-items: end;
    min-block-size: 0;
    overflow: hidden;
  }

  @media (max-width: 64rem) {
    .studio-footer__core {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 48rem) {
    .studio-footer__core {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      padding-block: var(--space-lg);
    }
    .studio-footer {
      block-size: auto;
      max-block-size: none;
      min-block-size: 0;
      overflow: visible;
    }
    /* The wordmark is a desktop-only closing signature — at mobile widths
     * it would clip against the inline gutter and read as a squeezed
     * orphan strip between the column stack and the small print. */
    .studio-footer__anchor {
      display: none;
    }
  }
</style>
