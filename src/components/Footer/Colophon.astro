---
/**
 * Footer Colophon — the small-press edition note for the site itself.
 * Lists typefaces, framework, hosting, and source as a typeset <dl>, with
 * each value linkable to the upstream so the curious view-source reader can
 * follow the trail. Distinct from src/components/Colophon.astro, which is
 * the per-document POSSE colophon at the foot of studies and notes.
 */
import t from '@/i18n';

const rows = t.footer.colophon.rows;
---

<section class="colophon" aria-labelledby="footer-colophon-heading">
  <h2 id="footer-colophon-heading" class="footer-section__heading">
    {t.footer.colophon.heading}
  </h2>
  <dl class="colophon-list">
    {
      rows.map((row) => (
        <>
          <dt>{row.key}</dt>
          <dd>
            {row.items.map((item, i) => (
              <>
                {i > 0 && <span aria-hidden="true">, </span>}
                <a href={item.href} rel="external noopener">
                  {item.label}
                </a>
              </>
            ))}
          </dd>
        </>
      ))
    }
  </dl>
</section>

<style>
  .colophon {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-section__heading {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 400;
    margin: 0;
  }

  .colophon-list {
    grid-template-columns: max-content 1fr;
    column-gap: var(--space-md);
    row-gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    line-height: var(--leading-meta);
    margin: 0;
  }

  .colophon-list dt {
    color: var(--color-secondary);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .colophon-list dd {
    color: var(--color-text);
    word-break: break-word;
  }

  .colophon-list a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .colophon-list a:hover {
    color: var(--color-link);
  }
</style>
