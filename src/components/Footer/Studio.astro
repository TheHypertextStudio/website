---
import { STUDIO_LOCATION } from '@/consts';
---

<section class="footer-studio" aria-labelledby="footer-studio-heading">
  <h2 id="footer-studio-heading" class="footer-section__heading">Studio</h2>
  <p class="lede">A small design lab building sustainable, human-centered software.</p>
  <address class="addr">
    Hypertext Studio<br />
    {STUDIO_LOCATION.street}<br />
    {STUDIO_LOCATION.locality}, {STUDIO_LOCATION.region}
    {STUDIO_LOCATION.postalCode}
  </address>
</section>

<style>
  .footer-studio {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-section__heading {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 400;
    margin: 0;
  }

  .footer-studio .lede {
    font-family: var(--font-serif);
    font-size: var(--font-size-small);
    line-height: var(--leading-body);
    color: var(--color-text);
    margin: 0;
    text-wrap: pretty;
    max-inline-size: 18em;
  }

  .footer-studio .addr {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    line-height: 1.5;
    color: var(--color-secondary);
    font-style: normal;
  }
</style>
