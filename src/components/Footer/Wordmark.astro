---
/* Footer closing wordmark — `<hypertext-studio />`. Scales to fill the
 * footer's content width via container-query units. */
---

<div class="footer-wordmark" aria-hidden="true">
  <span class="footer-wordmark__inner">
    <span class="syntax">&lt;</span>hypertext-studio<span class="syntax"> /&gt;</span>
  </span>
</div>

<style>
  .footer-wordmark {
    container-type: inline-size;
    padding-inline: var(--layout-margin);
    padding-block-end: var(--space-md);
    overflow: hidden;
  }

  .footer-wordmark__inner {
    display: block;
    font-family: var(--font-sans);
    font-weight: 700;
    /* Tuned to Inter 700 with -0.04em tracking on the literal string
     * `<hypertext-studio />` — change either and re-measure. */
    font-size: clamp(2.5rem, 11.3cqi, 32rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--color-text);
    white-space: nowrap;
  }

  .footer-wordmark__inner .syntax {
    color: var(--color-rule);
    font-weight: 500;
  }
</style>
