---
/**
 * Footer wordmark anchor — the self-closing custom-element tag
 * `<hypertext-studio/>`. Sits in the bottom-left of the anchor row, sized
 * to absorb the remaining vertical space so the footer reads as a closing
 * scene rather than two top-anchored bands with a void between them.
 */
---

<div class="footer-wordmark" aria-hidden="true">
  <span class="syntax">&lt;</span>hypertext-studio<span class="syntax"> /&gt;</span>
</div>

<style>
  .footer-wordmark {
    font-family: var(--font-sans);
    font-weight: 700;
    /* Anchors the closing band without bullying the rest of the footer.
     * Sized to fit comfortably between 2rem gutters at every common
     * desktop width — the previous 12vw / 9rem cap clipped the `/>` on
     * narrow desktops (64–80rem) under `white-space: nowrap`. */
    font-size: clamp(2.5rem, 8vw, 6.5rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--color-text);
    padding-inline: var(--layout-margin);
    /* Breathing room before the poem reads as a separate beat. */
    padding-block-end: var(--space-md);
    overflow: hidden;
    white-space: nowrap;
  }

  .footer-wordmark .syntax {
    color: var(--color-rule);
    font-weight: 500;
  }
</style>
