---
import t from '@/i18n';
---

<section class="footer-section" aria-labelledby="footer-identity-heading">
  <h2 id="footer-identity-heading" class="footer-section__heading">
    {t.footer.identity.heading}
  </h2>
  <ul class="footer-section__list">
    {
      t.footer.identity.items.map((item) => (
        <li>
          <a href={item.href} rel={item.rel} title={item.label}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .footer-section__heading {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 400;
    margin-block-end: var(--space-sm);
  }

  .footer-section__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    font-family: var(--font-sans);
    font-size: var(--font-size-small);
  }
</style>
