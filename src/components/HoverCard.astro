---
/* Shell + styles for the global hovercard. Dispatch and content live in
 * src/scripts/hovercard.ts. */
---

<aside id="hovercard" popover="manual" role="tooltip" data-kind=""></aside>

<style is:global>
  #hovercard {
    position: fixed;
    margin: 0;
    inset: auto;
    inline-size: min(22rem, calc(100vw - 2rem));
    max-inline-size: 22rem;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-rule);
    border-radius: 6px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 8px 24px -8px rgba(0, 0, 0, 0.18);
    font-family: var(--font-serif);
    font-size: var(--font-size-body-sm);
    line-height: 1.5;
    /* @starting-style below pairs with this transition so :popover-open
     * animates in from display:none. */
    opacity: 0;
    transition:
      opacity 120ms ease,
      transform 120ms ease;
    transform: translateY(2px);
    z-index: 1000;
  }

  #hovercard:popover-open {
    opacity: 1;
    transform: translateY(0);
  }

  @starting-style {
    #hovercard:popover-open {
      opacity: 0;
      transform: translateY(2px);
    }
  }

  #hovercard .hc-head {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-block-end: var(--space-xs);
  }

  #hovercard .hc-kind {
    font-family: var(--font-mono);
    font-size: var(--font-size-label-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-secondary);
  }

  #hovercard .hc-pill {
    font-family: var(--font-mono);
    font-size: var(--font-size-label-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    padding: 0.1em 0.5em;
  }

  #hovercard .hc-title {
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-xs) 0;
    text-wrap: pretty;
  }

  #hovercard .hc-summary {
    margin: 0;
    color: var(--color-text);
    text-wrap: pretty;
  }

  #hovercard .hc-preview {
    margin: 0;
    color: var(--color-text);
    text-wrap: pretty;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #hovercard .hc-muted {
    color: var(--color-secondary);
    font-style: italic;
  }

  #hovercard .hc-body {
    color: var(--color-text);
    text-wrap: pretty;
  }

  #hovercard .hc-body p {
    margin: 0;
  }

  #hovercard .hc-body p + p {
    margin-block-start: var(--space-xs);
  }

  #hovercard .hc-body a {
    color: var(--color-link);
  }

  #hovercard .hc-meta {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
    margin-block-start: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-label-sm);
    color: var(--color-secondary);
  }

  #hovercard .hc-meta-line {
    margin: var(--space-xs) 0 0 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-label-sm);
    color: var(--color-secondary);
  }

  #hovercard .hc-source {
    color: var(--color-secondary);
    word-break: break-all;
  }

  #hovercard .hc-sep {
    color: var(--color-rule);
  }

  #hovercard .hc-rel {
    color: var(--color-secondary);
  }

  #hovercard .hc-tags {
    list-style: none;
    margin: var(--space-sm) 0 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  #hovercard .hc-tags li {
    font-family: var(--font-mono);
    font-size: var(--font-size-label-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-secondary);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    padding: 0.1em 0.5em;
  }

  @media (prefers-reduced-motion: reduce) {
    #hovercard {
      transition: none;
      transform: none;
    }
    @starting-style {
      #hovercard:popover-open {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
