---
import t from '@/i18n';
import palette from '@/data/palette.json';
---

<dialog id="command-palette" class="command-palette" aria-labelledby="palette-title">
  <div class="palette__shell">
    <header class="palette__head">
      <h2 id="palette-title" class="sr-only">{t.palette.openLabel}</h2>
      <input
        type="search"
        id="palette-input"
        class="palette__input"
        placeholder={t.palette.placeholder}
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        role="combobox"
        aria-controls="palette-results"
        aria-expanded="true"
        aria-autocomplete="list"
      />
    </header>
    <ul id="palette-results" class="palette__results" role="listbox">
      {
        palette.map((item, i) => (
          <li
            class="palette__item"
            role="option"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-kind={item.kind}
            data-href={'href' in item ? item.href : undefined}
            data-open-dialog={'openDialog' in item ? item.openDialog : undefined}
            data-action={'action' in item ? item.action : undefined}
            data-external={'external' in item && item.external ? 'true' : undefined}
          >
            <span class="palette__kind">{item.kind}</span>
            <span class="palette__label">{item.label}</span>
            {'shortcut' in item && item.shortcut && (
              <kbd class="palette__shortcut">{item.shortcut}</kbd>
            )}
          </li>
        ))
      }
    </ul>
    <p id="palette-empty" class="palette__empty" hidden>{t.palette.noResults}</p>
  </div>
</dialog>

<style>
  .command-palette {
    inline-size: min(36rem, calc(100vw - 2rem));
    margin: 4rem auto auto;
    padding: 0;
    background: var(--color-bg);
    border: var(--rule-thin);
    color: var(--color-text);
  }

  .palette__shell {
    display: flex;
    flex-direction: column;
    max-block-size: 70dvh;
  }

  .palette__head {
    border-block-end: var(--rule-thin);
  }

  .palette__input {
    inline-size: 100%;
    padding: var(--space-md);
    font-family: var(--font-mono);
    font-size: 1rem;
    border: 0;
    background: transparent;
    color: inherit;
    outline: none;
  }

  .palette__results {
    list-style: none;
    margin: 0;
    padding: var(--space-sm) 0;
    overflow-y: auto;
  }

  .palette__item {
    display: grid;
    grid-template-columns: max-content 1fr max-content;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    cursor: pointer;
    font-size: var(--font-size-small);
  }

  .palette__item[hidden] {
    display: none;
  }

  .palette__item[aria-selected='true'] {
    background: rgba(0, 51, 204, 0.08);
  }

  .palette__kind {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    inline-size: 4rem;
  }

  /* The selected-item background tint reduces effective contrast for the
   * mid-gray kind label below WCAG AA. Lift the kind to the strong text
   * color on the selected row so axe and low-vision readers stay happy. */
  .palette__item[aria-selected='true'] .palette__kind,
  .palette__item[aria-selected='true'] .palette__shortcut {
    color: var(--color-text);
  }

  .palette__label {
    font-family: var(--font-sans);
    color: var(--color-text);
  }

  .palette__shortcut {
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-secondary);
    background: rgba(0, 0, 0, 0.04);
    padding: 0.1em 0.4em;
    border-radius: 2px;
  }

  .palette__empty {
    padding: var(--space-md);
    text-align: center;
    color: var(--color-secondary);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
  }
</style>
