---
/**
 * Product entry — research-index layout, not a marketing card.
 *
 * Reads top-to-bottom as a typeset entry: name + meta line (stage,
 * platforms, canonical URL when ready), the design question as the lede,
 * a description as body, and the figure inline as supporting illustration.
 *
 * No card border. No hover lift. No "Details" modal. No primary "Visit"
 * CTA button. The canonical URL (if the product is ready) lives in the
 * meta line as a regular link, treated like any reference.
 */

interface Metadata {
  stage: string;
  platforms: string[];
}

interface Props {
  slug: string;
  name: string;
  ready: boolean;
  question: string;
  metadata: Metadata;
  screenshot: string;
  screenshotAlt: string;
}

const { slug, name, ready, question, metadata, screenshot, screenshotAlt } = Astro.props;

const moreLabel = ready ? `Read about ${name}` : `Read about ${name}, in design`;
---

<article class="entry" id={slug}>
  <header class="entry__head">
    <h3 class="entry__name">{name}</h3>
    <p class="entry__meta">
      <span class="entry__stage">{metadata.stage}</span>
      <span aria-hidden="true">·</span>
      <span>{metadata.platforms.join(', ')}</span>
    </p>
  </header>

  <p class="entry__question">{question}</p>

  <figure class="entry__figure">
    <img src={screenshot} alt={screenshotAlt} loading="lazy" decoding="async" />
  </figure>

  <p class="entry__more">
    <button
      type="button"
      class="entry__trigger"
      data-dialog-target={`${slug}-detail`}
      aria-label={moreLabel}
    >
      Read more →
    </button>
  </p>
</article>

<style>
  .entry {
    display: grid;
    gap: var(--space-md);
    padding-block: var(--space-xl) var(--space-lg);
    border-block-start: var(--rule-thin);
    grid-template-columns: 1fr;
    /* Each product entry is a snap target on the document scroll. The
     * snap container is `html`; proximity means we only nudge when the
     * scroll lands near a boundary, so reading inside an entry is calm. */
    scroll-snap-align: start;
    scroll-snap-stop: normal;
  }

  .entry:first-of-type {
    border-block-start: none;
    padding-block-start: 0;
  }

  .entry__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .entry__name {
    /* Sub-section heading register — clearly below page section h2. */
    font-family: var(--font-sans);
    font-size: var(--font-size-title);
    font-weight: 600;
    margin: 0;
  }

  .entry__meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5ch;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: var(--font-size-label-sm);
    color: var(--color-secondary);
    margin: 0;
  }

  .entry__stage {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    font-weight: 500;
  }

  .entry__meta a {
    color: var(--color-link);
  }

  .entry__question {
    font-family: var(--font-serif);
    font-size: var(--font-size-body-lg);
    line-height: var(--leading-body);
    color: var(--color-text);
    margin: 0;
    text-wrap: pretty;
    max-inline-size: var(--measure);
  }

  .entry__figure {
    margin: 0;
    border: var(--rule-thin);
    background: rgba(0, 0, 0, 0.02);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    max-inline-size: 36rem;
  }

  .entry__figure img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* "Read more" — plain text link, not a CTA pill. The button element is
   * used because the action opens a dialog rather than navigating; styling
   * matches an inline link so the affordance reads as document, not as
   * marketing surface. */
  .entry__more {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-body-sm);
  }

  .entry__trigger {
    color: var(--color-link);
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .entry__trigger:hover {
    text-decoration-thickness: 2px;
  }
</style>
