---
import t from '@/i18n';
---

<aside id="status-bar" class="status-bar" aria-live="polite" aria-atomic="false">
  <span class="status-bar__url" data-url></span>
  <span class="status-bar__hint" data-hint hidden>{t.statusBar.modifierHint}</span>
</aside>

<style>
  .status-bar {
    position: fixed;
    inset-block-end: var(--space-sm);
    inset-inline-start: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-meta);
    color: var(--color-secondary);
    pointer-events: none;
    max-inline-size: calc(100vw - var(--space-md));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    z-index: 100;
    /* Hide when the footer is in view so we don't collide with the small-print row. */
    transition: opacity 120ms ease;
  }

  .status-bar[data-eclipsed] {
    opacity: 0;
    visibility: hidden;
  }

  html[data-modifier='on'] .status-bar__hint {
    display: inline;
  }
  html[data-modifier='on'] .status-bar__url {
    display: none;
  }

  @media print {
    .status-bar {
      display: none;
    }
  }

  /* On touch / narrow viewports the status bar is more clutter than craft. */
  @media (max-width: 40rem), (hover: none) {
    .status-bar {
      display: none;
    }
  }
</style>

<script>
  // Hide the status bar when the footer scrolls into view so the
  // bottom-left chip does not overlap the small-print row.
  const bar = document.querySelector<HTMLElement>('#status-bar');
  const footer = document.querySelector<HTMLElement>('footer.studio-footer');
  if (bar && footer && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      ([entry]) => bar.toggleAttribute('data-eclipsed', !!entry?.isIntersecting),
      { threshold: 0 },
    );
    io.observe(footer);
  }

  // Mirror the link's destination URL into the status bar — early-web
  // affordance the modern web abandoned. Cleared on mouseleave / blur.
  const slot = document.querySelector<HTMLElement>('#status-bar [data-url]');
  function setUrl(value: string): void {
    if (slot && slot.textContent !== value) slot.textContent = value;
  }
  function handleEnter(e: Event): void {
    const link = (e.target as HTMLElement | null)?.closest?.('a[href]');
    if (link instanceof HTMLAnchorElement) setUrl(link.href);
  }
  function handleLeave(e: Event): void {
    const link = (e.target as HTMLElement | null)?.closest?.('a[href]');
    if (link instanceof HTMLAnchorElement) setUrl('');
  }
  document.addEventListener('mouseover', handleEnter, { passive: true });
  document.addEventListener('mouseout', handleLeave, { passive: true });
  document.addEventListener('focusin', handleEnter);
  document.addEventListener('focusout', handleLeave);
</script>
