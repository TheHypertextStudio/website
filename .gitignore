# build output
dist/
build/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env*
!.env.example

# Cloudflare
.wrangler/
.dev.vars
.dev.vars.*

# build artifacts
.hypertext/*
test-results/
playwright-report/
coverage/
# Generated by scripts/og.sh during prebuild; rebuilt every deploy.
public/og.png
# Generated only when BLUESKY_DID is configured.
public/.well-known/atproto-did

# OS / IDE
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
/.hypertext/formatter-tools/runtime.json
/.hypertext/formatter-tools/bin/
/.hypertext/formatter-tools/__pycache__/

# Track shared formatter policy and launchers; runtime evidence remains ignored.
!.hypertext/formatters.json
!.hypertext/formatting/
!.hypertext/formatter-tools/

# Local Python bytecode is never part of the managed engine.
/.hypertext/formatting/**/__pycache__/
