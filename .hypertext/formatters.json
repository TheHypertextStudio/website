    },
    {
      "include": ["src/content/notes/.gitkeep"],
      "kind": "non-formattable",
      "reason": "Empty directory placeholder or intentionally empty data marker."
    },
    {
      "include": ["src/content/studies/.gitkeep"],
      "kind": "non-formattable",
      "reason": "Empty directory placeholder or intentionally empty data marker."
    },
    {
      "include": ["tests/unit/__snapshots__/feed.test.ts.snap"],
      "kind": "non-formattable",
      "reason": "Legal text, frozen observation, exact dependency/registration list, or opaque document data; preserve its consumer representation."
    }
  ]
}
