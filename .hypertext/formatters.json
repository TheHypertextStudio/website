    },
    {
      "include": ["public/favicon.ico"],
      "kind": "binary",
      "reason": "Binary media, font, signing, or tool archive; no text formatter applies."
    },
    {
      "include": ["public/fonts/IBMPlexMono-Regular.woff2"],
      "kind": "binary",
      "reason": "Binary media, font, signing, or tool archive; no text formatter applies."
    },
    {
      "include": ["public/fonts/InterVariable.woff2"],
      "kind": "binary",
      "reason": "Binary media, font, signing, or tool archive; no text formatter applies."
    },
    {
      "include": ["public/fonts/SourceSerif4Variable-Italic.woff2"],
      "kind": "binary",
      "reason": "Binary media, font, signing, or tool archive; no text formatter applies."
    },
    {
      "include": ["public/fonts/SourceSerif4Variable-Roman.woff2"],
      "kind": "binary",
      "reason": "Binary media, font, signing, or tool archive; no text formatter applies."
    },
    {
      "include": ["public/icon-192.png"],
      "kind": "binary",
      "reason": "Binary media, font, signing, or tool archive; no text formatter applies."
    },
    {
      "include": ["public/icon-512.png"],
      "kind": "binary",
      "reason": "Binary media, font, signing, or tool archive; no text formatter applies."
    },
    {
      "include": ["public/icon-maskable.png"],
