    },
    {
      "include": ["migrations/0001_create_webmentions.sql"],
      "kind": "non-formattable",
      "reason": "Already-published migration checksum contract; create a new migration instead of changing historical bytes."
    },
    {
      "include": ["pnpm-lock.yaml"],
      "kind": "generated",
      "reason": "Tool-owned dependency lock, credential/value file, or exact line protocol; preserve its semantic bytes."
    },
    {
