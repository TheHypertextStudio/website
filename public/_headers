# Cloudflare Pages security headers, applied to every response.
# Reference: §5.10 of the spec.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; connect-src 'self' https:
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Long-cache static assets.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/img/*
  Cache-Control: public, max-age=2592000

# Discovery endpoints — short cache so the contents stay fresh.
/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

/humans.txt
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/.well-known/atproto-did
  Content-Type: text/plain; charset=utf-8

/.well-known/webfinger
  Content-Type: application/jrd+json; charset=utf-8

/.well-known/host-meta
  Content-Type: application/xrd+xml; charset=utf-8

# Feeds — Astro's static build emits the bodies under their canonical mime
# types via the API route's Response, but the static dist file gets served
# with the platform's default mime. Pin the right type here so production
# Pages serves application/rss+xml etc. directly.
/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=3600

/atom.xml
  Content-Type: application/atom+xml; charset=utf-8
  Cache-Control: public, max-age=3600

/feed.json
  Content-Type: application/feed+json; charset=utf-8
  Cache-Control: public, max-age=3600
