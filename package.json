{
  "name": "@hypertextstudio/website",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Hypertext Studio builds software for humans.",
  "homepage": "https://hypertext.studio",
  "repository": {
    "type": "git",
    "url": "git@github.com:TheHypertextStudio/website.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "predev": "bash scripts/portless-reset.sh",
    "dev": "portless run astro dev",
    "dev:astro": "astro dev",
    "build": "bash scripts/build.sh",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "pretypecheck": "astro sync",
    "typecheck": "astro check && tsc --noEmit",
    "types:workers": "wrangler types workers/generated/www.d.ts --env www --env-interface WwwEnv --env-file /dev/null --include-runtime false && wrangler types workers/generated/poem.d.ts --env poem --env-interface PoemEnv --env-file /dev/null --include-runtime false && wrangler types workers/generated/webmention.d.ts --env webmention --env-interface WebmentionEnv --env-file /dev/null --include-runtime false && wrangler types workers/generated/micropub.d.ts --env micropub --env-interface MicropubEnv --env-file /dev/null --include-runtime false && wrangler types workers/generated/oembed.d.ts --env oembed --env-interface OembedEnv --env-file /dev/null --include-runtime false",
    "typecheck:workers": "pnpm run types:workers && tsc -p workers/tsconfig.json",
    "test": "vitest run",
    "test:workers": "node scripts/ci/run-worker-tests.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:artifact": "playwright test --config=playwright.artifact.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test --project=chromium --grep @a11y",
    "test:install": "playwright install --with-deps",
    "screenshots": "node scripts/screenshots.mjs",
    "doctor": "bash scripts/doctor.sh"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.9",
    "microformats-parser": "^2.0.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260825.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@typescript-eslint/parser": "^8.68.0",
    "axe-playwright": "^2.2.2",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "lint-staged": "^17.3.0",
    "portless": "^0.15.6",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  },
  "lint-staged": {
    "*.{astro,ts,tsx,js,mjs,cjs,css}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,mdx,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
