# Stricter peer dep handling for fewer surprises.
strict-peer-dependencies=false
auto-install-peers=true

# Don't auto-write workspace fields we don't use.
save-workspace-protocol=rolling

# Reproducible installs by default; CI uses --frozen-lockfile.
prefer-frozen-lockfile=true

# Match repo's pnpm via packageManager field; corepack handles activation.
manage-package-manager-versions=true

# Shared Studio packages are published to GitHub Packages. Authentication is
# configured at user level locally and temporarily by the CI setup action.
@thehypertextstudio:registry=https://npm.pkg.github.com
