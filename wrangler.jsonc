{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hypertext-studio-site-staging",
  "account_id": "2500680a3b2b0fe6a011c1c25fed5008",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "env": {
    "staging": {
      "name": "hypertext-studio-site-staging",
      "workers_dev": false,
      "preview_urls": false,
    },
    "production": {
      "name": "hypertext-studio-site",
      "routes": [
        {
          "pattern": "hypertext.studio/*",
          "zone_name": "hypertext.studio",
        },
      ],
    },
  },
  "workers_dev": false,
  "preview_urls": false,
}
